# Bookabook PDF Engine - Environment Configuration Template
# Never commit real credentials or secrets (.env is gitignored).

PROJECT_NAME="Bookabook PDF Engine API"
API_VERSION="1.0.0"
API_V1_STR="/api"

# Runtime Directories
DATA_DIR="data"
UPLOAD_DIR="data/uploads"
PREVIEW_DIR="data/previews"
LOCAL_STORAGE_DIR="data/storage"
DB_PATH="data/bookabook_review.db"

# Supabase PostgreSQL Metadata Database (required for Supabase PostgreSQL metadata persistence)
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Leave unset during offline dev/test to use local fallback repository.
DATABASE_URL=""

# Object Storage Backend: "local" (development) or "r2" (Cloudflare R2 production)
STORAGE_BACKEND="local"

# Cloudflare R2 Credentials (required only when STORAGE_BACKEND="r2")
R2_ENDPOINT_URL=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# Upload & Export Settings
MAX_UPLOAD_SIZE_BYTES=52428800
PREVIEW_DPI=100
PRODUCTION_EXPORT_DPI=300

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
