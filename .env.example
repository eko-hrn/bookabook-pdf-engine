# ==============================================================================
# Bookabook PDF Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file or real secrets to Git.
# ==============================================================================

PROJECT_NAME="Bookabook PDF Engine API"
API_VERSION="1.0.0"
API_V1_STR="/api"

# ------------------------------------------------------------------------------
# Runtime Data Directories (Local filesystem fallback & staging)
# ------------------------------------------------------------------------------
DATA_DIR="data"
UPLOAD_DIR="data/uploads"
PREVIEW_DIR="data/previews"
LOCAL_STORAGE_DIR="data/storage"
DB_PATH="data/bookabook_review.db"

# ------------------------------------------------------------------------------
# Database: Supabase PostgreSQL
# ------------------------------------------------------------------------------
# Use Supabase Session Pooler (port 6543) or Direct Connection (port 5432).
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# If left unset/empty, the backend falls back to local SQLite for offline development.
DATABASE_URL=""

# ------------------------------------------------------------------------------
# Storage Backend Selection
# ------------------------------------------------------------------------------
# Options:
#   "supabase"  - Supabase Storage (Production showcase - direct CDN delivery)
#   "local"     - Local filesystem storage (Offline development)
#   "r2"        - Cloudflare R2 object storage (Future migration ready)
STORAGE_BACKEND="supabase"

# ------------------------------------------------------------------------------
# Supabase Storage Configuration (Required when STORAGE_BACKEND="supabase")
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g. https://<project-ref>.supabase.co)
SUPABASE_URL=""

# Supabase Service Role Secret Key (Backend ONLY - NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=""

# Public Bucket Name for Showcase JPG Images
SUPABASE_STORAGE_BUCKET="bookabook-images"

# ------------------------------------------------------------------------------
# Cloudflare R2 Credentials (Optional / Future migration when STORAGE_BACKEND="r2")
# ------------------------------------------------------------------------------
R2_ENDPOINT_URL=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# ------------------------------------------------------------------------------
# Upload & Export Processing Settings
# ------------------------------------------------------------------------------
# Maximum upload file size in bytes (500 MB = 524,288,000 bytes for large PDF artwork)
MAX_UPLOAD_SIZE_BYTES=524288000

# DPI Resolutions
PREVIEW_DPI=100
PRODUCTION_EXPORT_DPI=300

# JPEG Size Limits (Strict bytes)
# COVER.jpg: max 400 KB (409,600 bytes)
COVER_MAX_BYTES=409600
# PAGE-01.jpg .. PAGE-N.jpg: max 400 KB (409,600 bytes)
INSIDE_PAGE_MAX_BYTES=409600
# BACKCOVER.jpg: max 1 MB (1,048,576 bytes)
BACKCOVER_MAX_BYTES=1048576

# Adaptive Compression Quality Settings
INITIAL_JPEG_QUALITY=95
MIN_JPEG_QUALITY_COVER=40
MIN_JPEG_QUALITY_INSIDE=40
MIN_JPEG_QUALITY_BACKCOVER=65

# ------------------------------------------------------------------------------
# CORS Settings
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
