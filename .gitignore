# ==============================================================================
# Bookabook PDF Engine - Git Ignore Rules
# ==============================================================================

# 1. Environment & Secrets (Never commit actual credentials)
.env
.env.*
*.env
!.env.example
!frontend/.env.example

# 2. Python Virtual Environments & Packages
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# 3. Python Cache & Test Artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/

# 4. Production PDFs & Sensitive Data
data/*.pdf
data/*.PDF

# 5. Local Runtime Storage, Uploads, Previews & Databases
data/storage/
data/uploads/
data/previews/
data/*.db
data/*.db-*
data/*.sqlite
data/*.sqlite3
output/
temp/
*.tmp
*.temp

# 6. Node.js & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/

# 7. Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 8. OS & IDE Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
